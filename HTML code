<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sequence Solver: Discover the Patterns</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            text-align: center;
            margin: 0;
            padding: 0;
        }
        h1 {
            font-size: 2.5rem;
            margin: 20px 0;
            color: #2c3e50;
        }
        .widget {
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin: 20px auto;
            width: 80%;
            max-width: 500px;
        }
        .level-widget {
            display: flex;
            justify-content: space-around;
            gap: 10px;
        }
        .level-widget button {
            padding: 10px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #3498db;
            color: white;
            transition: background-color 0.3s ease;
        }
        .level-widget button:hover {
            background-color: #2980b9;
        }
        .control-buttons {
            margin: 20px auto;
        }
        .control-buttons button {
            padding: 10px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #2ecc71;
            color: white;
            transition: background-color 0.3s ease;
        }
        .control-buttons button:hover {
            background-color: #27ae60;
        }
        .game-display {
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin: 20px auto;
            width: 80%;
            max-width: 600px;
            min-height: 150px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .game-display img {
            width: 50px;
            height: 50px;
        }
        .game-display span {
            font-size: 1.5rem;
            font-weight: bold;
        }
        #result {
            margin: 20px auto;
            font-size: 1.2rem;
            color: #e74c3c;
        }
    </style>
</head>
<body>
    <h1>Sequence Solver: Discover the Patterns</h1>

    <!-- Level Widget -->
    <div class="widget level-widget">
        <button onclick="setLevel('easy')">Easy</button>
        <button onclick="setLevel('intermediate')">Intermediate</button>
        <button onclick="setLevel('advanced')">Advanced</button>
    </div>

    <!-- Start Game Button -->
    <div class="control-buttons">
        <button onclick="startGame()">Start Game</button>
    </div>

    <!-- Game Display -->
    <div class="widget game-display" id="sequenceDisplay">
        <!-- Sequence will be displayed here -->
    </div>

    <!-- Result Display -->
    <div id="result"></div>

    <!-- End Game Button -->
    <div class="control-buttons">
        <button onclick="endGame()">End Game</button>
    </div>

    <script>
        const SEQUENCES = [
            // Number sequences
            [2, 4, 6, 8],
            [5, 10, 15, 20],
            [3, 6, 9, 12],
            [1, 4, 9, 16],
            [10, 7, 4, 1],
            [2, 5, 11, 20],
            [1, 3, 6, 10],
            [12, 9, 6, 3],
            [1, 2, 4, 8],
            [7, 14, 21, 28],
            // Letter sequences
            ['A', 'C', 'E', 'G'],
            ['B', 'D', 'F', 'H'],
            ['C', 'F', 'I', 'L'],
            ['D', 'G', 'J', 'M'],
            ['E', 'H', 'K', 'N'],
            ['F', 'I', 'L', 'O'],
            ['G', 'J', 'M', 'P'],
            ['H', 'K', 'N', 'Q'],
            ['I', 'L', 'O', 'R'],
            ['J', 'M', 'P', 'S'],
            // Image sequences (described by shape names)
            ['circle', 'square', 'triangle', 'circle'],
            ['square', 'triangle', 'circle', 'square'],
            ['triangle', 'circle', 'square', 'triangle'],
            ['circle', 'circle', 'square', 'square'],
            ['square', 'square', 'triangle', 'triangle']
        ];

        let currentLevel = 'easy';
        let gameRunning = false;
        let intervalId;

        function setLevel(level) {
            currentLevel = level;
            alert(`Level set to ${level.charAt(0).toUpperCase() + level.slice(1)}`);
        }

        function startGame() {
            if (!gameRunning) {
                gameRunning = true;
                document.getElementById('result').innerText = '';
                runSequence();
            }
        }

        function endGame() {
            gameRunning = false;
            clearInterval(intervalId);
            document.getElementById('sequenceDisplay').innerHTML = '';
            document.getElementById('result').innerText = 'Game ended.';
        }

        function runSequence() {
            if (!gameRunning) return;

            const sequence = getRandomSequence();
            displaySequence(sequence);

            setTimeout(() => {
                document.getElementById('sequenceDisplay').innerHTML = '';
                const userAnswer = prompt('What is the next item in the sequence?');
                checkAnswer(sequence, userAnswer);
                if (gameRunning) intervalId = setTimeout(runSequence, 1000);
            }, 3000);
        }

        function getRandomSequence() {
            let filteredSequences = SEQUENCES;
            if (currentLevel === 'easy') {
                filteredSequences = SEQUENCES.slice(0, 10); // Number sequences
            } else if (currentLevel === 'intermediate') {
                filteredSequences = SEQUENCES.slice(10, 20); // Letter sequences
            } else if (currentLevel === 'advanced') {
                filteredSequences = SEQUENCES.slice(20); // Image sequences
            }
            return filteredSequences[Math.floor(Math.random() * filteredSequences.length)];
        }

        function displaySequence(sequence) {
            const display = document.getElementById('sequenceDisplay');
            display.innerHTML = '';
            sequence.slice(0, -1).forEach(item => {
                if (typeof item === 'string' && ['circle', 'square', 'triangle'].includes(item)) {
                    const img = document.createElement('img');
                    img.src = generateImage(item);
                    display.appendChild(img);
                } else {
                    const span = document.createElement('span');
                    span.innerText = item + ' ';
                    display.appendChild(span);
                }
            });
        }

        function generateImage(shape) {
            const canvas = document.createElement('canvas');
            canvas.width = 50;
            canvas.height = 50;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, 50, 50);
            if (shape === 'circle') {
                ctx.beginPath();
                ctx.arc(25, 25, 20, 0, Math.PI * 2);
                ctx.fillStyle = 'blue';
                ctx.fill();
                ctx.stroke();
            } else if (shape === 'square') {
                ctx.fillStyle = 'red';
                ctx.fillRect(5, 5, 40, 40);
                ctx.strokeRect(5, 5, 40, 40);
            } else if (shape === 'triangle') {
                ctx.beginPath();
                ctx.moveTo(25, 5);
                ctx.lineTo(5, 45);
                ctx.lineTo(45, 45);
                ctx.closePath();
                ctx.fillStyle = 'green';
                ctx.fill();
                ctx.stroke();
            }
            return canvas.toDataURL();
        }

        function checkAnswer(sequence, userAnswer) {
            let correctAnswer;
            if (typeof sequence[0] === 'number') {
                const step = sequence[1] - sequence[0];
                correctAnswer = sequence[sequence.length - 1];
            } else if (typeof sequence[0] === 'string' && ['circle', 'square', 'triangle'].includes(sequence[0])) {
                correctAnswer = sequence[sequence.length - 1];
            } else {
                correctAnswer = String.fromCharCode(sequence[sequence.length - 2].charCodeAt(0) + 1);
            }

            if (userAnswer && userAnswer.toString().toLowerCase() === correctAnswer.toString().toLowerCase()) {
                document.getElementById('result').innerText = 'Correct! Well done!';
            } else {
                document.getElementById('result').innerText = `Sorry, the correct answer was ${correctAnswer}.`;
            }

        }
    </script>
</body>
</html>
